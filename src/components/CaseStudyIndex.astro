---
interface Item {
  id: string;
  label: string;
}
interface Props {
  items: Item[];
  accent: string;
}
const { items, accent } = Astro.props;
---

<nav
  data-index-nav
  aria-label="Section index"
  class="group fixed right-6 top-1/2 z-30 hidden -translate-y-1/2 flex-col items-end gap-3 lg:flex"
>
  {items.map((item) => (
    <a
      href={`#${item.id}`}
      data-index-link={item.id}
      data-cursor="link"
      class="index-link flex items-center gap-3 text-[11px] uppercase tracking-[0.12em] text-paper/40 transition-colors duration-300 hover:text-paper"
    >
      <span
        class="index-label max-w-0 overflow-hidden whitespace-nowrap opacity-0 transition-all duration-300 group-hover:max-w-[10rem] group-hover:opacity-100"
      >
        {item.label}
      </span>
      <span class="index-dot h-2 w-2 shrink-0 rounded-full border border-paper/40 transition-all duration-300"></span>
    </a>
  ))}
</nav>

<style define:vars={{ accent }}>
  .index-link[data-active='true'] {
    color: var(--color-paper);
  }
  .index-link[data-active='true'] .index-dot {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.3);
  }
</style>
