---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const logoUrl = `${import.meta.env.BASE_URL}logo-mark.png`;
---

<div
  class:list={['mascot relative overflow-hidden rounded-[2px] aspect-[4/5] grain', className]}
  style={`--mascot-mask:url(${logoUrl})`}
  data-mascot
>
  <div class="mascot-bg absolute inset-0"></div>
  <div class="mascot-ghost absolute inset-[16%]" data-mascot-ghost="a"></div>
  <div class="mascot-ghost absolute inset-[16%]" data-mascot-ghost="b"></div>
  <div class="mascot-wipe absolute inset-[16%]" data-mascot-wipe></div>
  <div class="mascot-mark absolute inset-[16%]" data-mascot-mark></div>
  <div class="absolute inset-0 flex items-end justify-between p-4 xs:p-5">
    <span class="font-display text-[10px] uppercase tracking-[0.15em] text-paper/70">
      Mood: unpredictable
    </span>
    <span class="h-1.5 w-1.5 rounded-full bg-paper/70" data-mascot-dot></span>
  </div>
</div>

<style>
  .mascot {
    background: var(--color-ink-soft);
    border: 1px solid var(--color-line);
  }
  .mascot-bg {
    background-image: radial-gradient(var(--color-line) 1px, transparent 1.3px);
    background-size: 10px 10px;
    opacity: 0.35;
  }
  .mascot-mark,
  .mascot-ghost,
  .mascot-wipe {
    -webkit-mask-image: var(--mascot-mask);
    mask-image: var(--mascot-mask);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .mascot-mark {
    background-color: var(--color-brand-coral);
    transform-origin: 50% 55%;
  }
  .mascot-ghost {
    opacity: 0;
    mix-blend-mode: screen;
  }
  .mascot-wipe {
    background-color: var(--color-brand-violet);
    clip-path: inset(0 100% 0 0);
  }
  [data-mascot-dot] {
    transition: background-color 0.15s steps(1);
  }
</style>
