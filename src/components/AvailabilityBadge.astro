---
interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Available for freelance & collaborations' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] text-paper/70', className]}>
  <span class="relative flex h-2 w-2">
    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-teal opacity-60"></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-teal"></span>
  </span>
  {label}
</span>
