---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 font-display', className]}>
  <img
    src={`${import.meta.env.BASE_URL}logo-mark.png`}
    alt=""
    width="26"
    height="26"
    class="h-[1.4em] w-[1.4em] shrink-0 object-contain"
  />
  <span class="tracking-[-0.01em]">BLACKSHEEP</span>
</span>
