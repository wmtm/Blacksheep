---
import Logo from './Logo.astro';
import FullscreenMenu from './FullscreenMenu.astro';
import { withBase } from '@/lib/paths';
import { buildWhatsAppLink, buildMailtoLink } from '@/lib/social';
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6 sm:pt-6" transition:persist>
  <div class="mx-auto flex max-w-[1600px] items-center justify-between rounded-full border border-line/70 bg-ink/70 px-4 py-2.5 backdrop-blur-md sm:px-5">
    <a href={withBase('/')} data-cursor="link" class="text-paper hover:opacity-80 transition-opacity">
      <Logo class="text-sm sm:text-base" />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <!--
        Persistent, always-tappable contact affordance (reachable from
        every page, every breakpoint -- the old "Let's talk" link here was
        `hidden sm:inline-flex`, so mobile had no one-tap path to Mathieu
        outside the nav drawer). WhatsApp leads since it's the faster
        channel on mobile; email is a second icon from sm up to avoid
        crowding the pill on small screens -- it stays reachable via
        Contact/the nav drawer/every footer CTA regardless.
      -->
      <a
        href={buildWhatsAppLink()}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor="link"
        data-magnetic="0.3"
        aria-label="Message Mathieu on WhatsApp"
        class="group inline-flex items-center gap-2 rounded-full border border-line px-3 py-2 text-[11px] uppercase tracking-[0.12em] text-paper/80 transition-colors duration-base hover:border-brand-teal hover:text-paper sm:px-4"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
          <path
            d="M1.5 14.5L2.4 11.3C1.8 10.3 1.5 9.1 1.5 7.9C1.5 4.3 4.6 1.5 8.3 1.5C12.1 1.5 15.2 4.3 15.2 7.9C15.2 11.4 12.1 14.2 8.3 14.2C7.1 14.2 6 13.9 5 13.4L1.5 14.5Z"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span class="hidden sm:inline">WhatsApp</span>
      </a>

      <a
        href={buildMailtoLink()}
        data-cursor="link"
        aria-label="Email Mathieu"
        class="hidden h-9 w-9 items-center justify-center rounded-full border border-line text-paper/80 transition-colors duration-base hover:border-paper hover:text-paper sm:inline-flex"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"></rect>
          <path d="M1.5 4L8 9L14.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-menu"
        data-cursor="link"
        class="flex items-center gap-2.5 rounded-full border border-line py-2 pl-4 pr-3 text-[11px] uppercase tracking-[0.12em] text-paper transition-colors duration-300 hover:border-paper"
      >
        <span>Menu</span>
        <span class="relative flex h-3 w-4 flex-col justify-between">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div transition:persist id="nav-root">
  <FullscreenMenu />
</div>
