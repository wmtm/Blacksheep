---
import { SOCIALS, buildWhatsAppLink, buildMailtoLink } from '@/lib/social';
import AvailabilityBadge from './AvailabilityBadge.astro';

interface Props {
  showCta?: boolean;
  /** Eyebrow line above the heading. Defaults to the generic sitewide pitch. */
  ctaEyebrow?: string;
  /** The big headline. Defaults to the generic sitewide pitch. */
  ctaHeading?: string;
  /** A project/service name to prefill into the WhatsApp/email message, so a
   * case study or Services card closes with "I'd like to talk about X"
   * instead of a generic opener. */
  ctaContext?: string;
}
const {
  showCta = true,
  ctaEyebrow = 'You have an idea. We have too many.',
  ctaHeading = "Let's combine them.",
  ctaContext,
} = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-line bg-ink">
  {showCta && (
    <div class="relative border-b border-line px-6 py-24 sm:px-12 sm:py-32 lg:px-20">
      <div class="pointer-events-none absolute inset-0 opacity-40 [background:radial-gradient(60%_60%_at_20%_20%,var(--color-brand-violet),transparent_60%),radial-gradient(50%_50%_at_85%_80%,var(--color-brand-coral),transparent_60%)]"></div>
      <div class="relative mx-auto max-w-5xl text-center">
        <p data-reveal class="mb-4 text-[11px] uppercase tracking-[0.2em] text-paper/50">
          {ctaEyebrow}
        </p>
        <h2 data-reveal data-reveal-delay="0.08" class="font-display text-[10.5vw] leading-[0.95] tracking-[-0.03em] sm:text-6xl lg:text-7xl">
          {ctaHeading}
        </h2>
        <div data-reveal data-reveal-delay="0.16" class="mt-10 flex flex-col items-center gap-5">
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href={buildWhatsAppLink(ctaContext)}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="drag"
              data-cursor-text="Say hi"
              data-magnetic="0.4"
              class="group inline-flex items-center gap-3 rounded-full bg-paper px-8 py-4 font-display text-lg text-ink transition-transform duration-base ease-spring hover:scale-[1.03] sm:text-xl"
            >
              Message on WhatsApp
              <span class="grid h-8 w-8 place-items-center rounded-full bg-ink text-paper transition-transform duration-base group-hover:translate-x-1 group-hover:-translate-y-1">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M2 12L12 2M12 2H4M12 2V10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </a>
            <a
              href={buildMailtoLink(ctaContext)}
              data-cursor="link"
              class="inline-flex items-center gap-2 rounded-full border border-line px-6 py-4 text-[11px] uppercase tracking-[0.12em] text-paper/80 transition-colors duration-base hover:border-paper hover:text-paper"
            >
              Email instead
            </a>
          </div>
          <AvailabilityBadge />
        </div>
      </div>
    </div>
  )}

  <div class="mx-auto flex max-w-[1600px] flex-col gap-8 px-6 py-10 sm:px-12 sm:flex-row sm:items-center sm:justify-between lg:px-20">
    <div class="flex flex-col gap-1">
      <p class="font-display text-sm tracking-[-0.01em]">BLACKSHEEP</p>
      <p class="text-[11px] text-paper/40">© {year} BlackSheep, Mathieu Maigrot. All rights reserved.</p>
    </div>

    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {SOCIALS.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noreferrer"
            data-cursor="link"
            class="text-[11px] uppercase tracking-[0.15em] text-paper/50 transition-colors duration-base hover:text-paper"
          >
            {social.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      data-scroll-top
      data-cursor="link"
      data-magnetic="0.5"
      class="flex items-center gap-2 self-start text-[11px] uppercase tracking-[0.15em] text-paper/50 transition-colors duration-base hover:text-paper sm:self-auto"
      aria-label="Back to top"
    >
      Back to top
      <span class="grid h-7 w-7 place-items-center rounded-full border border-line">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
          <path d="M5 9V1M5 1L1 5M5 1L9 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </button>
  </div>
</footer>

<script>
  function bind() {
    document.querySelectorAll('[data-scroll-top]').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
