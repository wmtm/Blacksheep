---
import { CATEGORY_LIST } from '@/lib/categories';
import { SOCIALS } from '@/lib/social';
import { withBase } from '@/lib/paths';
import AvailabilityBadge from './AvailabilityBadge.astro';

const primaryLinks = [
  { label: 'Selected work', href: withBase('/') },
  { label: 'All work', href: withBase('/work/') },
  { label: 'About', href: withBase('/about/') },
  { label: 'Contact', href: withBase('/contact/') },
];
---

<div
  data-nav-menu
  class="fixed inset-0 z-40 flex-col bg-ink text-paper"
  style="display:none;"
  aria-hidden="true"
>
  <div class="grain absolute inset-0 pointer-events-none"></div>
  <div class="relative flex h-full flex-col justify-between px-6 pb-8 pt-28 sm:px-12 sm:pb-12 lg:px-20">
    <nav class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <ul class="flex flex-col gap-1">
        {primaryLinks.map((link, i) => (
          <li data-nav-link class="overflow-hidden">
            <a
              href={link.href}
              data-cursor="link"
              class="group flex items-baseline gap-4 py-2 font-display text-[13vw] leading-[0.95] tracking-[-0.03em] text-paper/90 transition-colors duration-300 hover:text-brand-coral sm:text-[7vw] lg:text-[5.2vw]"
            >
              <span class="text-[0.28em] font-body font-normal text-paper/40">0{i + 1}</span>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div data-nav-link class="flex flex-col justify-center gap-6 border-t border-line pt-8 lg:border-t-0 lg:border-l lg:pl-10 lg:pt-0">
        <p class="text-[11px] uppercase tracking-[0.15em] text-paper/40">Make it —</p>
        <ul class="flex flex-col gap-3">
          {CATEGORY_LIST.map((cat) => (
            <li>
              <a
                href={withBase(`/work/?cat=${cat.id}`)}
                data-cursor="link"
                class="group flex items-center gap-3 font-display text-lg text-paper/70 transition-colors duration-300 hover:text-paper"
              >
                <span
                  class="h-1.5 w-1.5 rounded-full transition-transform duration-300 group-hover:scale-150"
                  style={`background:${cat.accent}`}
                ></span>
                {cat.verb}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div data-nav-link class="flex flex-col gap-6 border-t border-line pt-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex flex-col gap-3">
        <AvailabilityBadge />
        <p class="text-[11px] uppercase tracking-[0.15em] text-paper/40">
          Mauritius / Everywhere — <span data-clock>--:--</span>
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {SOCIALS.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noreferrer"
              data-cursor="link"
              class="text-[11px] uppercase tracking-[0.15em] text-paper/60 underline decoration-transparent underline-offset-4 transition-colors duration-300 hover:text-brand-coral hover:decoration-brand-coral"
            >
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <button
    type="button"
    data-nav-close
    data-cursor="close"
    aria-label="Close menu"
    class="absolute right-6 top-7 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-line text-paper transition-colors duration-300 hover:border-paper sm:right-10"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
    </svg>
  </button>
</div>
