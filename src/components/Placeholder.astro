---
import type { CategoryId } from '@/lib/categories';

interface Props {
  ratio?: '16:9' | '4:5' | '1:1' | 'full';
  kind?: 'image' | 'video';
  label: string;
  accent?: string;
  seed?: string;
  category?: CategoryId;
  tilt?: boolean;
  class?: string;
}

const {
  ratio = '4:5',
  kind = 'image',
  label,
  accent = '#ff4b6e',
  seed,
  category,
  tilt = true,
  class: className = '',
} = Astro.props;

const ratioMap: Record<string, string> = {
  '16:9': 'aspect-[16/9]',
  '4:5': 'aspect-[4/5]',
  '1:1': 'aspect-square',
  full: 'aspect-[21/9]',
};

// Deterministic "fictional artwork" generator: a small abstract composition,
// seeded from the label and biased by category (branding gets a bold
// centered mark, editorial gets column rules, digital gets a grid, etc.)
// so placeholders read as intentional rather than randomly decorative.
// Server-side only, no runtime cost.
function hashString(str: string): number {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = (Math.imul(31, h) + str.charCodeAt(i)) | 0;
  }
  return h >>> 0;
}

function mulberry32(seedNum: number) {
  let a = seedNum;
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Shape =
  | { kind: 'circle'; cx: number; cy: number; r: number; fill: string; opacity: number }
  | { kind: 'rect'; x: number; y: number; w: number; h: number; rotate: number; fill: string; opacity: number }
  | { kind: 'triangle'; points: string; rotate: number; cx: number; cy: number; fill: string; opacity: number }
  | { kind: 'line'; x1: number; y1: number; x2: number; y2: number; stroke: string; opacity: number };

const rand = mulberry32(hashString(seed ?? label));
const palette = ['var(--paper)', 'var(--accent)', 'var(--ink)'];
const pick = <T,>(arr: T[]): T => arr[Math.floor(rand() * arr.length)];

function randomShape(): Shape {
  const type = Math.floor(rand() * 4);
  const fill = pick(palette);
  const opacity = 0.5 + rand() * 0.4;

  if (type === 0) {
    return { kind: 'circle', cx: rand() * 100, cy: rand() * 100, r: 6 + rand() * 20, fill, opacity };
  }
  if (type === 1) {
    const w = 10 + rand() * 30;
    return { kind: 'rect', x: rand() * 100, y: rand() * 100, w, h: w * (0.3 + rand() * 0.7), rotate: rand() * 90 - 45, fill, opacity };
  }
  if (type === 2) {
    const size = 12 + rand() * 22;
    const cx = rand() * 100;
    const cy = rand() * 100;
    const points = `${cx},${cy - size} ${cx + size},${cy + size} ${cx - size},${cy + size}`;
    return { kind: 'triangle', points, rotate: rand() * 360, cx, cy, fill, opacity };
  }
  const x1 = rand() * 100;
  const y1 = rand() * 100;
  const angle = rand() * Math.PI * 2;
  const len = 30 + rand() * 50;
  return {
    kind: 'line',
    x1,
    y1,
    x2: x1 + Math.cos(angle) * len,
    y2: y1 + Math.sin(angle) * len,
    stroke: pick(palette),
    opacity: 0.35 + rand() * 0.35,
  };
}

function buildShapes(): Shape[] {
  // Branding — one bold, centered mark (circle + triangle overlap), like a logo.
  if (category === 'branding') {
    const cx = 42 + rand() * 16;
    const cy = 42 + rand() * 16;
    const r = 20 + rand() * 10;
    const size = 22 + rand() * 10;
    const points = `${cx},${cy - size} ${cx + size},${cy + size} ${cx - size},${cy + size}`;
    return [
      { kind: 'circle', cx, cy, r, fill: pick(palette), opacity: 0.55 },
      { kind: 'triangle', points, rotate: rand() * 360, cx, cy, fill: pick(palette), opacity: 0.7 },
      { kind: 'circle', cx: cx + r * 0.6, cy: cy - r * 0.6, r: r * 0.3, fill: 'var(--paper)', opacity: 0.5 },
    ];
  }

  // Motion — streaking diagonal lines suggesting movement/blur.
  if (category === 'motion') {
    const angle = -0.5 + rand() * 0.3;
    return Array.from({ length: 7 + Math.floor(rand() * 4) }).map(() => {
      const y1 = rand() * 100;
      const len = 60 + rand() * 60;
      return {
        kind: 'line' as const,
        x1: -10,
        y1,
        x2: -10 + Math.cos(angle) * len,
        y2: y1 + Math.sin(angle) * len,
        stroke: pick(palette),
        opacity: 0.3 + rand() * 0.4,
      };
    });
  }

  // Digital — a loose grid of rectangles, like UI blocks.
  if (category === 'digital') {
    const cols = 3;
    const rows = 3;
    const shapes: Shape[] = [];
    for (let i = 0; i < cols; i++) {
      for (let j = 0; j < rows; j++) {
        if (rand() > 0.55) continue;
        const w = 100 / cols;
        const h = 100 / rows;
        shapes.push({
          kind: 'rect',
          x: i * w + w * 0.15,
          y: j * h + h * 0.15,
          w: w * (0.5 + rand() * 0.4),
          h: h * (0.5 + rand() * 0.4),
          rotate: 0,
          fill: pick(palette),
          opacity: 0.4 + rand() * 0.4,
        });
      }
    }
    return shapes;
  }

  // Illustration — clustered organic circles.
  if (category === 'illustration') {
    const clusterX = 30 + rand() * 40;
    const clusterY = 30 + rand() * 40;
    return Array.from({ length: 6 + Math.floor(rand() * 5) }).map(() => ({
      kind: 'circle' as const,
      cx: clusterX + (rand() - 0.5) * 60,
      cy: clusterY + (rand() - 0.5) * 60,
      r: 5 + rand() * 16,
      fill: pick(palette),
      opacity: 0.35 + rand() * 0.4,
    }));
  }

  // Editorial — horizontal rules mimicking text columns, plus a divider.
  if (category === 'editorial') {
    const shapes: Shape[] = [];
    const lineCount = 6 + Math.floor(rand() * 4);
    for (let i = 0; i < lineCount; i++) {
      const y = 12 + (i / lineCount) * 76 + rand() * 4;
      const fullWidth = rand() > 0.75;
      shapes.push({
        kind: 'line',
        x1: 8,
        y1: y,
        x2: fullWidth ? 92 : 30 + rand() * 55,
        y2: y,
        stroke: pick(palette),
        opacity: 0.35 + rand() * 0.35,
      });
    }
    shapes.push({ kind: 'line', x1: 50, y1: 8, x2: 50, y2: 92, stroke: pick(palette), opacity: 0.25 });
    return shapes;
  }

  // Experiments (or no category) — fully chaotic mix.
  const shapeCount = 5 + Math.floor(rand() * 5);
  return Array.from({ length: shapeCount }).map(() => randomShape());
}

const shapes = buildShapes();
---

<div
  class:list={[
    'placeholder-media relative overflow-hidden rounded-[2px]',
    ratioMap[ratio],
    className,
  ]}
  style={`--accent:${accent}`}
  data-placeholder
  data-kind={kind}
  data-tilt={tilt ? '7' : undefined}
>
  <div class="placeholder-bg absolute inset-0"></div>
  <svg
    class="placeholder-art absolute inset-0 h-full w-full mix-blend-soft-light"
    viewBox="0 0 100 100"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    {shapes.map((s) => {
      if (s.kind === 'circle') {
        return <circle cx={s.cx} cy={s.cy} r={s.r} fill={s.fill} opacity={s.opacity} />;
      }
      if (s.kind === 'rect') {
        return (
          <rect
            x={s.x}
            y={s.y}
            width={s.w}
            height={s.h}
            fill={s.fill}
            opacity={s.opacity}
            transform={`rotate(${s.rotate} ${s.x} ${s.y})`}
          />
        );
      }
      if (s.kind === 'triangle') {
        return (
          <polygon
            points={s.points}
            fill={s.fill}
            opacity={s.opacity}
            transform={`rotate(${s.rotate} ${s.cx} ${s.cy})`}
          />
        );
      }
      return (
        <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke={s.stroke} stroke-width="0.6" opacity={s.opacity} />
      );
    })}
  </svg>
  <div class="grain absolute inset-0"></div>
  <div class="absolute inset-0 flex flex-col justify-between p-4 xs:p-5">
    <div class="flex items-center justify-between text-[10px] tracking-[0.15em] uppercase font-display text-paper/80">
      <span class="flex items-center gap-1.5">
        {kind === 'video' && (
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-paper animate-pulse"></span>
        )}
        {kind}
      </span>
      <span>{ratio}</span>
    </div>
    <p class="font-display text-xs xs:text-sm tracking-[0.06em] uppercase text-paper/90 leading-snug">
      {label}
    </p>
  </div>
  {kind === 'video' && (
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <span class="play-ring flex h-14 w-14 items-center justify-center rounded-full border border-paper/50">
        <svg width="14" height="16" viewBox="0 0 14 16" fill="none" class="translate-x-[1px]">
          <path d="M0 0L14 8L0 16V0Z" fill="currentColor" class="text-paper/90"></path>
        </svg>
      </span>
    </div>
  )}
</div>

<style>
  .placeholder-media {
    background: color-mix(in srgb, var(--accent) 18%, #0b0b0c);
    --paper: #f6f3ee;
    --ink: #0b0b0c;
  }
  .placeholder-bg {
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent) 55%, transparent) 0px,
        color-mix(in srgb, var(--accent) 55%, transparent) 1.5px,
        transparent 1.5px,
        transparent 34px
      ),
      radial-gradient(120% 120% at 15% 15%, color-mix(in srgb, var(--accent) 65%, transparent), transparent 60%),
      radial-gradient(140% 140% at 100% 100%, color-mix(in srgb, var(--accent) 40%, transparent), transparent 55%),
      var(--color-ink-soft, #17171a);
    opacity: 0.9;
    transition: transform 0.7s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  [data-placeholder]:hover .placeholder-bg {
    transform: scale(1.04);
  }
  .placeholder-art {
    transition: transform 0.7s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  [data-placeholder]:hover .placeholder-art {
    transform: scale(1.06) rotate(1deg);
  }
  /* "Reel playing" cue: video placeholders drift gently while hovered,
     suggesting motion instead of a static frame. */
  [data-placeholder][data-kind='video']:hover .placeholder-art {
    animation: reel-drift 2.6s ease-in-out infinite;
  }
  @keyframes reel-drift {
    0%,
    100% {
      transform: scale(1.06) rotate(0.4deg) translate(0, 0);
    }
    50% {
      transform: scale(1.09) rotate(-0.4deg) translate(1px, -1px);
    }
  }
  .play-ring {
    transition: transform 0.4s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }
  [data-placeholder]:hover .play-ring {
    transform: scale(1.1);
  }
</style>
