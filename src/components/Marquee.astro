---
interface Props {
  items: string[];
  /** Parallel to items: when given, each item becomes a link instead of
   * plain decorative text. Only the first (visible, tab-reachable) copy of
   * the looped track renders real <a> tags; the duplicate used to make the
   * scroll seamless stays non-interactive so keyboard/AT users don't hit
   * the same link twice, once of it invisible. */
  hrefs?: string[];
  speed?: number;
  class?: string;
  outline?: boolean;
}
const { items, hrefs, speed = 28, class: className = '', outline = false } = Astro.props;
const itemClass = [
  'flex items-center gap-8 whitespace-nowrap font-display text-[10vw] leading-none transition-colors duration-base sm:text-6xl',
  outline ? 'text-outline' : 'text-paper/90',
].join(' ');
---

<div class:list={['marquee overflow-hidden', className]} style={`--speed:${speed}s`}>
  <div class="marquee-track flex w-max items-center">
    {[0, 1].map((copy) => (
      <ul class="flex items-center gap-8 pr-8" aria-hidden={copy === 1 || !hrefs ? 'true' : undefined}>
        {items.map((item, i) => (
          <li>
            {hrefs && copy === 0 ? (
              <a href={hrefs[i]} data-cursor="link" class:list={[itemClass, 'hover:text-brand-coral']}>
                {item}
                <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-coral align-middle"></span>
              </a>
            ) : (
              <span class:list={itemClass}>
                {item}
                <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-coral align-middle"></span>
              </span>
            )}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee-scroll var(--speed) linear infinite;
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
