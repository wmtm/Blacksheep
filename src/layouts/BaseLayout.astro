---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { withBase } from '@/lib/paths';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  showFooterCta?: boolean;
  footerCtaEyebrow?: string;
  footerCtaHeading?: string;
  footerCtaContext?: string;
  ogImageLabel?: string;
}

const {
  title,
  description = 'BlackSheep: Graphic & Motion Designer turning ideas into things you can see, feel and remember. Based in Mauritius, working everywhere.',
  showFooterCta = true,
  footerCtaEyebrow,
  footerCtaHeading,
  footerCtaContext,
} = Astro.props;

const pageTitle = title === 'BlackSheep' ? title : `${title} · BlackSheep`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase('/og.jpg'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <ClientRouter />
  </head>
  <body class="grain">
    <!-- Page transition wipe panels -->
    <div class="pointer-events-none fixed inset-0 z-[999] flex" aria-hidden="true">
      <div data-transition-panel class="h-full w-1/3 origin-bottom scale-y-0 bg-brand-violet"></div>
      <div data-transition-panel class="h-full w-1/3 origin-bottom scale-y-0 bg-ink"></div>
      <div data-transition-panel class="h-full w-1/3 origin-bottom scale-y-0 bg-brand-coral"></div>
    </div>

    <!-- Custom cursor: purely decorative, hidden from assistive tech -->
    <div data-cursor-dot class="cursor-dot" aria-hidden="true" transition:persist></div>
    <div data-cursor-ring class="cursor-ring" aria-hidden="true" transition:persist></div>

    <Header />

    <main>
      <slot />
    </main>

    <Footer showCta={showFooterCta} ctaEyebrow={footerCtaEyebrow} ctaHeading={footerCtaHeading} ctaContext={footerCtaContext} />

    <script src="../scripts/main.ts"></script>
  </body>
</html>
