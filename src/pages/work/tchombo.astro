---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudyIndex from '@/components/CaseStudyIndex.astro';
import Media from '@/components/Media.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '@/lib/categories';
import { withBase } from '@/lib/paths';
import { buildWhatsAppLink } from '@/lib/social';
import { readableTextOn } from '@/lib/color';

const allProjects = await getCollection('projects');
const allIds = [...allProjects].sort((a, b) => a.data.order - b.data.order).map((p) => p.id);
const project = allProjects.find((p) => p.id === 'tchombo')!;
const { data } = project;
const cat = CATEGORIES[data.category];

const currentIndex = allIds.indexOf('tchombo');
const nextId = allIds[(currentIndex + 1) % allIds.length];
const nextProject = allProjects.find((p) => p.id === nextId)!;
const nextCat = CATEGORIES[nextProject.data.category];

const media = (file: string) => withBase(`/media/tchombo/${file}`);

const steps = [
  {
    n: '01',
    name: 'Raise',
    color: data.accent,
    rotate: -2,
    text: 'A real fact about Mauritius drops with no answer attached. Name a number higher than the last one named. Anyone can keep going.',
  },
  {
    n: '02',
    name: 'Call TCHOMBO',
    color: 'var(--color-brand-coral)',
    rotate: 1,
    text: "Think the last player already overshot the true number? Call TCHOMBO on them and bet your read is right.",
  },
  {
    n: '03',
    name: 'Call exact',
    color: 'var(--color-brand-gold)',
    rotate: -1,
    text: 'Know the precise figure? Call it exact instead. Nail it and nobody loses a dodo. Miss and the cost is yours alone.',
  },
];

const flock = [
  { src: media('mascot-tchombo.png'), caption: 'Still in it', rotate: -3 },
  { src: media('mascot-gagn-twa.png'), caption: 'Gagn twa! Called it exact.', rotate: 3 },
  { src: media('mascot-ayo.png'), caption: "Ayo! That one's on you.", rotate: -2 },
];

const stats = [
  { n: '860', label: 'Trivia questions' },
  { n: '2', label: 'Languages, full parity' },
  { n: '15', label: 'Dodo lives to lose' },
  { n: '0', label: 'Installs or accounts' },
];

const buildStats = [
  { n: '43', label: 'Commits' },
  { n: '~3', label: 'Weeks, start to live' },
  { n: '47', label: 'Unit tests on the game engine' },
];

const indexItems = [
  { id: 'overview', label: 'Overview' },
  { id: 'how-it-plays', label: 'How it plays' },
  { id: 'flock', label: 'The flock' },
  { id: 'built', label: 'How it was built' },
  { id: 'next', label: 'Next project' },
];
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  footerCtaEyebrow="Liked what you saw?"
  footerCtaHeading="Let's start yours."
  footerCtaContext={data.title}
>
  <CaseStudyIndex items={indexItems} accent={data.accent} />
  <div class="fixed inset-x-0 top-0 z-40 h-[3px] origin-left scale-x-0 bg-paper" data-scroll-progress></div>

  <section id="overview" class="relative overflow-hidden px-6 pb-16 pt-36 sm:px-12 sm:pt-44 lg:px-20">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -right-32 -top-10 h-[26rem] w-[32rem] rounded-full bg-[#2E6E52]/20 blur-[110px]"></div>
      <div class="absolute -right-10 bottom-0 h-[20rem] w-[26rem] rounded-full bg-brand-gold/15 blur-[100px]"></div>
    </div>

    <a
      href={withBase('/work/')}
      data-cursor="link"
      class="relative mb-10 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.15em] text-paper/50 transition-colors hover:text-paper"
    >
      ← All work
    </a>

    <div class="relative grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:gap-16">
      <div data-reveal>
        <p class="mb-4 flex items-center gap-2 text-[11px] uppercase tracking-[0.15em] text-paper/50">
          <span class="h-1.5 w-1.5 rounded-full" style={`background:${cat.accent}`}></span>
          {cat.label} · {data.year} · Live now
        </p>
        <h1 class="font-display text-[11vw] leading-[0.92] tracking-[-0.03em] sm:text-6xl lg:text-[5.2vw]">
          {data.title}
        </h1>
        <p class="mt-5 max-w-md text-xl text-paper/60 sm:text-2xl">How far can you push it?</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={data.live}
            target="_blank"
            rel="noopener noreferrer"
            data-cursor="link"
            data-magnetic="0.3"
            class="inline-flex items-center gap-2 rounded-full px-6 py-3.5 font-display text-sm transition-transform duration-base ease-spring hover:scale-[1.03]"
            style={`background:${data.accent};color:${readableTextOn(data.accent)}`}
          >
            Play it live <span>↗</span>
          </a>
          <a
            href={buildWhatsAppLink('TCHOMBO')}
            target="_blank"
            rel="noopener noreferrer"
            data-cursor="link"
            class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-3.5 text-[11px] uppercase tracking-[0.12em] text-paper/80 transition-colors duration-base hover:border-paper"
          >
            Got a game idea? Let's build it <span>→</span>
          </a>
        </div>
      </div>

      <dl data-reveal data-reveal-delay="0.1" class="grid grid-cols-2 gap-6 border-t border-line pt-6 text-sm lg:border-t-0 lg:pt-0">
        <div>
          <dt class="text-[11px] uppercase tracking-[0.12em] text-paper/50">Client</dt>
          <dd class="mt-1 text-paper/80">{data.client}</dd>
        </div>
        <div>
          <dt class="text-[11px] uppercase tracking-[0.12em] text-paper/50">Role</dt>
          <dd class="mt-1 text-paper/80">{data.role.join(', ')}</dd>
        </div>
        <div class="col-span-2">
          <dt class="text-[11px] uppercase tracking-[0.12em] text-paper/50">Summary</dt>
          <dd class="mt-1 text-paper/80">{data.summary}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section data-reveal class="px-6 pb-20 sm:px-12 lg:px-20">
    <a
      href={data.live}
      target="_blank"
      rel="noopener noreferrer"
      data-cursor="view"
      data-cursor-text="Play"
      data-cursor-accent={data.accent}
      class="tchombo-sticker relative mx-auto block w-fit"
      aria-label="Play TCHOMBO"
    >
      <div class="tchombo-bob">
        <Media
          ratio={data.cover.ratio}
          kind={data.cover.kind}
          label={data.cover.label}
          accent={data.accent}
          category={data.category}
          src={data.cover.src}
          transparent={data.cover.transparent}
          fit={data.cover.fit}
        />
      </div>
      <span class="pointer-events-none absolute bottom-4 left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 rounded-full bg-[#0E1E3A] px-3 py-1.5 font-display text-[10px] uppercase tracking-[0.08em] text-paper">
        <span class="h-1.5 w-1.5 rounded-full" style={`background:${data.accent}`}></span>
        Live · play now
      </span>
    </a>
  </section>

  <section id="how-it-plays" class="border-t border-line px-6 py-16 sm:px-12 sm:py-24 lg:px-20">
    <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/50">How it plays</p>
    <h2 data-reveal data-reveal-delay="0.06" class="font-display max-w-xl text-3xl leading-[1.08] tracking-[-0.01em] sm:text-4xl lg:text-5xl">
      Three ways a round can end.
    </h2>

    <div data-reveal-group class="mt-12 grid gap-4 sm:grid-cols-3">
      {steps.map((step) => (
        <div data-reveal-item class="tchombo-step-card flex flex-col gap-5 rounded-2xl border border-line bg-ink-soft p-8" style={`--rotate:${step.rotate}deg`}>
          <span class="font-display text-sm" style={`color:${step.color}`}>{step.n}</span>
          <h3 class="font-display text-2xl">{step.name}</h3>
          <p class="text-sm leading-relaxed text-paper/60">{step.text}</p>
          <span class="mt-auto h-1 w-10 rounded-full" style={`background:${step.color}`}></span>
        </div>
      ))}
    </div>

    <p data-reveal data-reveal-delay="0.1" class="mt-8 max-w-2xl text-paper/60">
      Guess wrong and you lose dodos, and missing an easy one costs more than missing a brutal one: the one rule that keeps everybody honest.
    </p>
  </section>

  <section id="flock" class="border-t border-line px-6 py-16 sm:px-12 sm:py-24 lg:px-20">
    <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/50">The flock</p>
    <h2 data-reveal data-reveal-delay="0.06" class="font-display max-w-xl text-3xl leading-[1.08] tracking-[-0.01em] sm:text-4xl lg:text-5xl">
      One dodo, three moods.
    </h2>

    <div data-reveal-group class="mt-12 flex flex-wrap justify-center gap-6 sm:gap-10">
      {flock.map((bird) => (
        <div data-reveal-item class="flex w-40 flex-col items-center text-center sm:w-48">
          <div class="tchombo-flock-card flex aspect-square w-full items-center justify-center rounded-2xl border border-line-soft bg-paper p-6" style={`--rotate:${bird.rotate}deg`}>
            <img src={bird.src} alt={bird.caption} loading="lazy" decoding="async" class="h-full w-full object-contain" />
          </div>
          <p class="mt-4 text-sm text-paper/60">{bird.caption}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="built" class="border-t border-line px-6 py-16 sm:px-12 sm:py-24 lg:px-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.8fr] lg:gap-20">
      <div>
        <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/50">How it was built</p>
        <h2 data-reveal data-reveal-delay="0.06" class="font-display text-3xl leading-[1.08] tracking-[-0.01em] sm:text-4xl lg:text-5xl">
          Built the same way it plays: out loud.
        </h2>
        <p data-reveal data-reveal-delay="0.12" class="mt-6 max-w-lg text-paper/60">
          The real-time engine, the bilingual interface, the trivia itself: all of it came out of a running conversation with an AI pair programmer instead of a blank editor, over a few weeks of back and forth. Every rule was specified in plain language, built, tested and re-checked against the live app before it shipped.
        </p>
      </div>

      <dl data-reveal-group class="grid grid-cols-3 gap-6 self-start border-t border-line pt-8 lg:border-t-0 lg:pt-0">
        {buildStats.map((s) => (
          <div data-reveal-item>
            <dt class="font-display text-3xl sm:text-4xl">{s.n}</dt>
            <dd class="mt-1 text-[11px] uppercase tracking-[0.1em] text-paper/50">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <dl data-reveal-group class="mt-16 grid grid-cols-2 gap-6 border-t border-line pt-8 sm:grid-cols-4">
      {stats.map((s) => (
        <div data-reveal-item>
          <dt class="font-display text-3xl sm:text-4xl">{s.n}</dt>
          <dd class="mt-1 text-[11px] uppercase tracking-[0.1em] text-paper/50">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="next" class="border-t border-line px-6 py-20 sm:px-12 sm:py-28 lg:px-20">
    <p data-reveal class="mb-6 text-[11px] uppercase tracking-[0.15em] text-paper/50">Next project</p>
    <a
      href={withBase(`/work/${nextProject.id}/`)}
      data-preview-trigger
      data-cursor="view"
      data-cursor-text="View"
      data-cursor-accent={nextProject.data.accent}
      class="group relative block"
    >
      <div data-reveal class="flex items-baseline justify-between gap-6 border-b border-line pb-8">
        <h2 class="font-display text-[11vw] leading-[0.92] tracking-[-0.03em] transition-colors duration-slow group-hover:text-brand-coral sm:text-6xl lg:text-7xl">
          {nextProject.data.title}
        </h2>
        <span class="hidden shrink-0 items-center gap-2 text-[11px] uppercase tracking-[0.15em] text-paper/50 sm:flex">
          <span class="h-1.5 w-1.5 rounded-full" style={`background:${nextCat.accent}`}></span>
          {nextCat.short}
        </span>
      </div>

      <div
        data-preview-thumb
        aria-hidden="true"
        class="pointer-events-none absolute left-0 top-0 hidden w-64 -translate-x-1/2 -translate-y-1/2 sm:block"
      >
        <Media ratio="4:5" kind={nextProject.data.cover.kind} label={nextProject.data.cover.label} accent={nextProject.data.accent} category={nextProject.data.category} src={nextProject.data.cover.src} poster={nextProject.data.cover.poster} transparent={nextProject.data.cover.transparent} fit={nextProject.data.cover.fit} tilt={false} />
      </div>
    </a>
  </section>
</BaseLayout>

<style>
  /*
   * A live, playable party game deserves more energy than a flat grid of
   * cards. These add a scattered-stickers tilt + a springy hover pop on the
   * three "fun" sections (hero mascot, how-it-plays, the flock), reusing
   * the sitewide --ease-spring/--duration-slow tokens so it still feels
   * like part of the same system, not a one-off. Everything here is a
   * plain CSS transition/animation on its own element -- never the same
   * element the GSAP tilt in Media.astro controls -- so nothing fights it.
   */
  .tchombo-sticker {
    transform: rotate(-2deg);
    transition: transform var(--duration-slow) var(--ease-spring);
  }
  .tchombo-sticker:hover {
    transform: rotate(0deg) scale(1.04);
  }
  .tchombo-bob {
    animation: tchombo-bob 4.4s var(--ease-in-out-quart) infinite;
  }

  .tchombo-step-card,
  .tchombo-flock-card {
    transform: rotate(var(--rotate, 0deg));
    transition: transform var(--duration-slow) var(--ease-spring);
  }
  .tchombo-step-card:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.02);
  }
  .tchombo-flock-card:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.08);
  }

  @keyframes tchombo-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tchombo-sticker,
    .tchombo-step-card,
    .tchombo-flock-card {
      transition: none;
      transform: none;
    }
    .tchombo-bob {
      animation: none;
    }
  }
</style>
