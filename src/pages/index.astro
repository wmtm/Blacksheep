---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Placeholder from '@/components/Placeholder.astro';
import Marquee from '@/components/Marquee.astro';
import AvailabilityBadge from '@/components/AvailabilityBadge.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_LIST } from '@/lib/categories';
import { withBase } from '@/lib/paths';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="BlackSheep">
  <!-- Hero -->
  <section class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden px-6 pb-16 pt-40 sm:px-12 sm:pb-24 lg:px-20">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -left-40 top-10 h-[38rem] w-[38rem] rounded-full bg-brand-violet/25 blur-[120px]"></div>
      <div class="absolute -right-32 top-1/3 h-[32rem] w-[32rem] rounded-full bg-brand-coral/20 blur-[120px]"></div>
    </div>

    <div class="relative">
      <p data-reveal class="mb-6 flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-paper/50">
        Graphic &amp; Motion Designer — Mauritius / Everywhere
      </p>

      <h1 data-reveal-lines class="font-display text-[13.5vw] leading-[0.92] tracking-[-0.03em] sm:text-[9vw] lg:text-[7.4vw]">
        <span class="block overflow-hidden"><span data-line class="block">WE MAKE</span></span>
        <span class="block overflow-hidden"><span data-line class="block">THINGS <em class="text-outline not-italic">MOVE.</em></span></span>
      </h1>

      <div class="mt-6 flex flex-col gap-6 sm:mt-8 sm:flex-row sm:items-end sm:justify-between">
        <p data-reveal data-reveal-delay="0.15" class="max-w-md text-lg text-paper/60 sm:text-xl">
          Sometimes literally. Graphic design, motion, visual identities, digital, illustration &amp; the occasional weird side project.
        </p>
        <div data-reveal data-reveal-delay="0.25" class="flex items-center gap-4">
          <AvailabilityBadge />
        </div>
      </div>
    </div>

    <a
      href="#work"
      data-cursor="link"
      class="group absolute bottom-8 right-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.15em] text-paper/50 transition-colors hover:text-paper sm:right-12 lg:right-20"
    >
      <span class="hidden sm:inline">Scroll</span>
      <span class="flex h-10 w-10 items-center justify-center rounded-full border border-line transition-transform duration-500 group-hover:translate-y-1">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M6 1V11M6 11L1.5 6.5M6 11L10.5 6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </section>

  <!-- Marquee strip -->
  <section class="border-y border-line py-6">
    <Marquee items={['GRAPHIC DESIGN', 'MOTION', 'VISUAL IDENTITY', 'DIGITAL', 'ILLUSTRATION']} outline speed={32} />
  </section>

  <!-- Selected work -->
  <section id="work" class="px-6 py-24 sm:px-12 sm:py-32 lg:px-20">
    <div class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/40">Selected work</p>
        <h2 data-reveal data-reveal-delay="0.08" class="font-display text-4xl tracking-[-0.02em] sm:text-5xl">
          A few things<br />worth your scroll.
        </h2>
      </div>
      <a
        href={withBase('/work/')}
        data-cursor="link"
        data-magnetic="0.3"
        class="group inline-flex w-fit items-center gap-2 rounded-full border border-line px-5 py-3 text-[11px] uppercase tracking-[0.12em] transition-colors duration-300 hover:border-paper"
      >
        View full archive
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div data-reveal-group class="grid grid-cols-1 gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project, i) => (
        <div
          data-reveal-item
          class:list={['flex flex-col', i % 5 === 0 ? 'sm:col-span-2 lg:col-span-2' : '']}
        >
          <ProjectCard project={project} index={i} />
        </div>
      ))}
    </div>
  </section>

  <!-- Category verbs marquee -->
  <section class="border-y border-line py-6">
    <Marquee
      items={CATEGORY_LIST.map((c) => c.verb.replace('.', ''))}
      speed={40}
    />
  </section>

  <!-- About teaser -->
  <section class="px-6 py-24 sm:px-12 sm:py-32 lg:px-20">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-20">
      <div data-reveal class="order-2 lg:order-1">
        <Placeholder ratio="4:5" kind="image" label="MATHIEU — PORTRAIT" accent="#6C4CFF" class="max-w-md" />
      </div>
      <div class="order-1 lg:order-2">
        <p data-reveal class="mb-4 text-[11px] uppercase tracking-[0.15em] text-paper/40">About</p>
        <h2 data-reveal data-reveal-delay="0.08" class="font-display text-3xl leading-[1.05] tracking-[-0.02em] sm:text-4xl lg:text-5xl">
          I'm Mathieu Maigrot — graphic &amp; motion designer, professional overthinker of pixels.
        </h2>
        <p data-reveal data-reveal-delay="0.16" class="mt-6 max-w-lg text-paper/60">
          Based in Mauritius, working across visual identity, animation and digital design — for clients everywhere, and for the occasional idea that doesn't need a client to exist.
        </p>
        <a
          href={withBase('/about/')}
          data-cursor="link"
          data-magnetic="0.3"
          data-reveal
          data-reveal-delay="0.24"
          class="mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-paper px-6 py-3.5 font-display text-sm text-ink transition-transform duration-300 hover:scale-[1.03]"
        >
          More about me
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
