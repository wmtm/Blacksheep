---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { STUDIO_SERVICES, BEYOND_SERVICES } from '@/lib/services';

const whoItIsFor = [
  { label: 'I run a small business', href: '#design-support' },
  { label: 'I host guests', href: '#mapmaking' },
  { label: "I'm a studio", href: '#studio' },
  { label: 'I want to play', href: '#beyond-the-brief' },
];

const process = [
  { n: '01', label: 'Message', text: "Say hi on WhatsApp or email, with whatever you've got: a rough idea, a deadline, a Pinterest board." },
  { n: '02', label: 'Quote', text: "A clear, no-pressure quote back, scoped to what you actually need. No price list: every project's different." },
  { n: '03', label: 'Create', text: 'Sketches, drafts, revisions, built in the open so nothing lands as a surprise.' },
  { n: '04', label: 'Deliver', text: 'Final files, handed over clean, ready to use.' },
];
---

<BaseLayout
  title="Services"
  description="Branding, motion, digital, illustration, editorial and ongoing design support, plus custom maps, game design and game nights. Quote-only, message Mathieu on WhatsApp or email."
>
  <section class="relative flex min-h-[60svh] flex-col justify-end overflow-hidden px-6 pb-16 pt-40 sm:px-12 sm:pb-24 lg:px-20">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute left-1/2 -top-24 h-[22rem] w-[52rem] -translate-x-1/2 rounded-full bg-brand-violet/20 blur-[130px]"></div>
      <div class="absolute -right-16 bottom-0 h-[14rem] w-[14rem] rounded-full bg-brand-gold/20 blur-[90px]"></div>
    </div>

    <div class="relative">
      <p data-reveal class="mb-6 text-[11px] uppercase tracking-[0.2em] text-paper/50">Services</p>
      <h1 data-reveal-lines class="font-display text-[12.5vw] leading-[0.92] tracking-[-0.03em] sm:text-7xl lg:text-[6vw]">
        <span class="block overflow-hidden"><span data-line class="block">Design, and a few</span></span>
        <span class="block overflow-hidden"><span data-line class="block">things beyond it.</span></span>
      </h1>
      <p data-reveal data-reveal-delay="0.15" class="mt-6 max-w-xl text-lg text-paper/60 sm:text-xl">
        Nine ways to work with Mathieu: six studio disciplines, and three things that don't fit a normal
        brief at all. Quote-only, no price list: message him and he'll scope it to what you actually need.
      </p>
    </div>
  </section>

  <!-- Who it's for: quick entry points into the service list below -->
  <section class="border-t border-line px-6 py-10 sm:px-12 lg:px-20">
    <p data-reveal class="mb-5 text-[11px] uppercase tracking-[0.15em] text-paper/50">Find your fit</p>
    <div data-reveal-group class="flex flex-wrap gap-3">
      {whoItIsFor.map((w) => (
        <a
          href={w.href}
          data-reveal-item
          data-cursor="link"
          class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-3 text-sm text-paper/80 transition-colors duration-base hover:border-paper hover:text-paper"
        >
          {w.label} <span class="text-paper/50">↓</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Studio -->
  <section id="studio" class="border-t border-line px-6 py-20 sm:px-12 sm:py-28 lg:px-20">
    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/50">Studio</p>
        <h2 data-reveal data-reveal-delay="0.06" class="font-display text-4xl tracking-[-0.02em] sm:text-5xl">
          The client-facing six.
        </h2>
      </div>
      <p data-reveal data-reveal-delay="0.1" class="max-w-sm text-paper/50">
        Branding, motion, digital, illustration, editorial, and ongoing support for teams without an
        in-house designer.
      </p>
    </div>

    <div data-reveal-group class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {STUDIO_SERVICES.map((service) => (
        <div id={service.id} class="scroll-mt-28">
          <ServiceCard service={service} />
        </div>
      ))}
    </div>
  </section>

  <!-- Beyond the brief -->
  <section id="beyond-the-brief" class="border-t border-line px-6 py-20 sm:px-12 sm:py-28 lg:px-20">
    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/50">Beyond the brief</p>
        <h2 data-reveal data-reveal-delay="0.06" class="font-display text-4xl tracking-[-0.02em] sm:text-5xl">
          Also at the table.
        </h2>
      </div>
      <p data-reveal data-reveal-delay="0.1" class="max-w-sm text-paper/50">
        Maps, games and a seat at the table: the things he'd build even without a client, that turned out
        to be worth hiring him for too.
      </p>
    </div>

    <div data-reveal-group class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {BEYOND_SERVICES.map((service) => (
        <div id={service.id} class="scroll-mt-28">
          <ServiceCard service={service} />
        </div>
      ))}
    </div>
  </section>

  <!-- How we work -->
  <section class="relative isolate overflow-hidden border-t border-line px-6 py-20 sm:px-12 sm:py-28 lg:px-20">
    <div class="dot-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <p data-reveal class="mb-3 text-[11px] uppercase tracking-[0.15em] text-paper/50">How we work</p>
    <h2 data-reveal data-reveal-delay="0.06" class="font-display text-4xl tracking-[-0.02em] sm:text-5xl">
      Four steps, no price list.
    </h2>

    <div data-reveal-group class="relative mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div data-reveal-line class="pointer-events-none absolute left-0 right-0 top-[18px] hidden h-px bg-line lg:block" aria-hidden="true"></div>
      {process.map((step) => (
        <div data-reveal-item class="relative flex flex-col gap-3">
          <span class="relative w-fit rounded-full bg-ink px-1 font-display text-sm text-paper/50">{step.n}</span>
          <h3 class="font-display text-xl">{step.label}</h3>
          <p class="text-sm leading-relaxed text-paper/60">{step.text}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
